# ---------------------------------------------------------------------------
# Bright Mtalii Portfolio — environment variables
# Copy this file to `.env.local` and fill in the values you need.
# `.env.local` is git-ignored and never committed.
# ---------------------------------------------------------------------------

# Required in production: the public URL where the site is deployed.
# Used for canonical URLs, Open Graph metadata, sitemap.xml and robots.txt.
# In development it falls back to http://localhost:3000
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional: shown in the contact section and the footer.
# Leave empty and the UI will tell you to configure it instead of inventing one.
NEXT_PUBLIC_CONTACT_EMAIL=""


# ---------------------------------------------------------------------------
# Contact form delivery
# ---------------------------------------------------------------------------
# Provider to use when someone submits the contact form.
#   resend  -> sends through Resend (https://resend.com) using RESEND_API_KEY
#   webhook -> POSTs the JSON payload to CONTACT_WEBHOOK_URL
#   none    -> development mode: validates + logs the message, sends nothing,
#              and the UI honestly reports that delivery is not configured.
EMAIL_PROVIDER="none"

# resend
RESEND_API_KEY=""
CONTACT_FROM_EMAIL="Bright Mtalii Portfolio <onboarding@resend.dev>"
CONTACT_TO_EMAIL=""

# webhook (any provider that accepts a JSON POST: Formspree, Zapier, Make, ...)
CONTACT_WEBHOOK_URL=""

# Optional: override the default rate limit (requests per window, window ms)
CONTACT_RATE_LIMIT_MAX="5"
CONTACT_RATE_LIMIT_WINDOW_MS="600000"


# ---------------------------------------------------------------------------
# Ask Bright assistant (/api/ask)
# ---------------------------------------------------------------------------
# By default the assistant is fully local and deterministic: it answers from
# src/data/knowledge.ts with no external calls. Leave ASK_PROVIDER unset/"local"
# to keep it free and private.
#
#   local -> deterministic keyword engine (default)
#   llm   -> OpenAI-compatible chat completion, grounded by a system prompt
#            built from the site data (set ASK_API_KEY below).
ASK_PROVIDER="local"

# Only needed when ASK_PROVIDER="llm". Server-side only — never exposed to the client.
ASK_API_KEY=""
ASK_BASE_URL="https://api.openai.com/v1"
ASK_MODEL="gpt-4o-mini"

# Optional: override the auto-generated assistant system prompt.
# ASK_SYSTEM_PROMPT=""

# Optional: override the default rate limit (questions per window, window ms)
ASK_RATE_LIMIT_MAX="30"
ASK_RATE_LIMIT_WINDOW_MS="60000"

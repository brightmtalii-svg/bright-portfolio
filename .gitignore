# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local temp test scripts
/scripts/tmp/

# archived/scratch material kept out of version control
/.archive/

# manual review of ambiguous recovered files
/review/

# recovery inventories / temporary scratch files
RECOVERY_REPORT.md
RECOVERY_*.json
*.inventory
*.tmp
/tmp/

# explicitly keep environment secrets out (in addition to .env* above)
.env.local
.env.production
.env.*.local

# generated build caches and framework artifacts
.turbo/
.cache/
out/
build/
/coverage

# OS / editor junk
.vscode/
.idea/
*.swp
Thumbs.db
